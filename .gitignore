# JAVA / MAVEN / SPRING
# ========================
target/
*.class
*.jar
*.war
*.ear
*.log
# Escludi la cartella wrapper se preferisci usare il maven globale,
# ma spesso è meglio tenerla. Se la vuoi tenere, rimuovi la riga sotto:
!.mvn/wrapper/maven-wrapper.jar

# ========================
# SICUREZZA (IMPORTANTE)
# ========================
# Ignora chiavi private, certificati e file codificati in base64
*.pem
*.pub
*.key
*.p12
*.b64
# Ignora file di configurazione locali che potrebbero contenere password
backend_logic/**/config/*.pem
backend_logic/**/config/*.b64


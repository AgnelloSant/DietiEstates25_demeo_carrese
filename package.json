{
  "name": "property-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start:eureka": "cd backend_logic/eureka-server && ./mvnw spring-boot:run",
    "start:user": "cd backend_logic/user-service && ./mvnw spring-boot:run",
    "start:property": "cd backend_logic/property-service && ./mvnw spring-boot:run",
    "start:frontend": "cd frontend && npm run dev",
    "start:backend": "npm-run-all --parallel start:eureka start:user start:property",
    "start:frontend:delayed": "sleep 20 && npm run start:frontend",
    "start:all": "npm-run-all --parallel start:backend start:frontend:delayed"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "vue": "^3.3.0",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@types/leaflet-draw": "^1.0.13",
    "@vitejs/plugin-vue": "^5.0.0",
    "npm-run-all": "^4.1.5",
    "vite": "^5.0.0"
  }
}
